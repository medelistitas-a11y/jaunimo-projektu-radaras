# Nukopijuok į .env ir užpildyk. NIEKADA nekomituok tikro .env failo.

# --- Duomenų bazė ---
DATABASE_URL=postgresql+psycopg://mostai:mostai@db:5432/mostai
# Testams (naudojama automatiškai pytest metu, jei nenurodyta kitaip):
TEST_DATABASE_URL=sqlite+pysqlite:///./test.db

# --- Programos nustatymai ---
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
ADMIN_CONTACT_EMAIL=info@example.lt
# HTTP User-Agent, naudojamas crawleryje. Turi turėti kontaktinį el. paštą.
CRAWLER_USER_AGENT=MostaiGalimybiuRadaras/0.1 (+mailto:info@example.lt)

# --- Vienintelio vartotojo autentifikacija (naudojama, jei programa pasiekiama ne tik localhost) ---
ADMIN_USERNAME=admin
# Slaptažodžio hash (bcrypt). Sugeneruok su: python -m app.scripts.hash_password
ADMIN_PASSWORD_HASH=

# --- Kasdienis grafikas ---
SCHEDULER_ENABLED=true
DAILY_CRAWL_TIME=06:30
TIMEZONE=Europe/Vilnius

# --- Crawler ribojimai ---
CRAWLER_MAX_URLS_PER_SOURCE=60
CRAWLER_MAX_DEPTH=2
CRAWLER_REQUEST_TIMEOUT_SECONDS=20
CRAWLER_MIN_DELAY_SECONDS=1.5
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_DOWNLOAD_MB=15

# --- Pasirenkamas Anthropic LLM klasifikatorius ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Pasirenkama kasdienė el. pašto santrauka (SMTP). Palikus tuščią SMTP_HOST, siuntimas išjungtas. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Mostai galimybių radaras <noreply@example.lt>
SMTP_TO=jums@example.lt
SMTP_USE_TLS=true
WEEKLY_EMPTY_SUMMARY=false

# --- OCR ---
OCR_ENABLED=true
OCR_LANGUAGES=lit+eng

# --- Dokumentų saugojimas ---
DOCUMENT_RETENTION_DAYS=365
DOCUMENT_STORAGE_DIR=/data/documents
MAX_DOCUMENT_SIZE_MB=20
